{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-miner.local/schemas/project-learning-guide-1.0.json",
  "title": "Career Miner Project Learning Guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_status",
    "language",
    "project_name",
    "project_overview",
    "overview_evidence",
    "technologies",
    "flows",
    "study_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "career-miner/project-learning-guide/1.0"
    },
    "approval_status": {
      "type": "string",
      "enum": ["REVIEW_REQUIRED", "APPROVED"]
    },
    "language": {
      "type": "string",
      "enum": ["zh-CN", "en-US"]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_overview": {
      "type": "string",
      "minLength": 1
    },
    "overview_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "project_usage",
          "integration",
          "learning_notes",
          "evidence"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "project_usage": {"type": "string", "minLength": 1},
          "integration": {"type": "string", "minLength": 1},
          "learning_notes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "design_considerations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/evidence"}
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "steps"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "detail", "technologies", "evidence"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "detail": {"type": "string", "minLength": 1},
                "technologies": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/evidence"}
                }
              }
            }
          }
        }
      }
    },
    "study_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "supports", "source_type"],
      "properties": {
        "citation": {"type": "string", "minLength": 1},
        "supports": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": ["REPOSITORY", "USER_STATEMENT"]
        }
      }
    }
  }
}
